{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LLDP Scan Request",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": ["ssh", "meraki"]
    },
    "emitRaw": { "type": "boolean" },
    "vendor": {
      "type": "string",
      "enum": ["mock", "aruba", "cisco", "auto"]
    },
    "seedDevices": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "credentials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "username": { "type": "string" },
          "password": { "type": "string" },
          "sshKeyPath": { "type": "string" },
          "privateKey": { "type": "string" },
          "passphrase": { "type": "string" },
          "useAgent": { "type": "boolean" },
          "description": { "type": "string" }
        },
        "required": ["id", "username"]
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "vendorsAllowList": {
          "type": "array",
          "items": { "type": "string", "enum": ["aruba", "cisco"] }
        },
        "resolveNeighbors": {
          "type": "string",
          "enum": ["none", "dns", "dns+hostmap", "arp", "dns+arp", "dns+hostmap+arp"]
        },
        "hostmap": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "includeEndpoints": {
          "type": "boolean"
        },
        "maxAttemptsPerHost": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "connectTimeoutMs": {
          "type": "number",
          "minimum": 200,
          "maximum": 20000
        },
        "tcpProbeTimeoutMs": {
          "type": "number",
          "minimum": 100,
          "maximum": 3000
        },
        "sshCompatibility": {
          "type": "string",
          "enum": ["modern", "legacy", "legacy-cisco"]
        },
        "sshMode": {
          "type": "string",
          "enum": ["auto", "force-modern", "force-legacy", "force-legacy-cisco"]
        },
        "debugSsh": {
          "type": "boolean"
        },
        "debug": {
          "type": "boolean"
        },
        "timeoutMs": { "type": "number", "minimum": 1000, "maximum": 600000 },
        "concurrency": { "type": "number", "minimum": 1, "maximum": 50 },
        "retries": { "type": "number", "minimum": 0, "maximum": 5 }
      },
      "additionalProperties": false
    },
    "meraki": {
      "type": "object",
      "properties": {
        "apiKey": { "type": "string" },
        "orgId": { "type": "string" },
        "orgName": { "type": "string" },
        "networkId": { "type": "string" }
      },
      "required": ["apiKey"],
      "additionalProperties": false
    }
  },
  "required": ["source"],
  "allOf": [
    {
      "if": { "properties": { "source": { "const": "meraki" } } },
      "then": {
        "required": ["meraki"],
        "properties": {
          "meraki": {
            "type": "object",
            "required": ["apiKey"],
            "properties": {
              "apiKey": { "type": "string" },
              "orgId": { "type": "string" },
              "orgName": { "type": "string" },
              "networkId": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "source": { "const": "ssh" } } },
      "then": {
        "required": ["vendor", "seedDevices", "credentials"]
      }
    }
  ],
  "additionalProperties": false
}
